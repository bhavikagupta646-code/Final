PORT=5000
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000
ALLOW_VERCEL_PREVIEWS=true
MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/healthshield?retryWrites=true&w=majority
JWT_ACCESS_SECRET=<64-byte-secure-hex-string>
JWT_REFRESH_SECRET=<64-byte-secure-hex-string>
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d
RECORD_HMAC_SECRET=<32-byte-secure-hex-string>
SEPOLIA_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/<alchemy-key>
CHAIN_ID=11155111
BACKEND_OPERATOR_PRIVATE_KEY=<private-key-with-sepolia-eth>
